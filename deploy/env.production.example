# Copy to /opt/forge/.env on the server (chmod 600) and fill in every <...> value.
# Replace 203.0.113.10 with your server's public IP everywhere.
# Generate secrets with: openssl rand -base64 32

# --- Secrets
FORGE_ENCRYPTION_KEY=<openssl rand -base64 32>
FORGE_JWT_SECRET=<openssl rand -base64 32>
FORGE_DB_PASSWORD=<openssl rand -hex 16>
FORGE_GITHUB_WEBHOOK_SECRET=<openssl rand -hex 20>

# --- Engine: Docker on Linux (Apple container only exists on macOS)
FORGE_ENGINE=docker
FORGE_REGISTRY=
FORGE_WORKSPACE_DIR=/var/lib/forge/builds

# --- Database (the Postgres container from infra/docker-compose.prod.yml)
FORGE_DB_URL=jdbc:postgresql://localhost:5432/forge
FORGE_DB_USER=forge

# --- Public addresses. sslip.io turns <anything>.203.0.113.10.sslip.io into 203.0.113.10,
# so every project gets its own hostname with no DNS setup.
FORGE_APPS_DOMAIN=203.0.113.10.sslip.io
FORGE_PUBLIC_API_URL=http://203.0.113.10:8080
FORGE_DASHBOARD_URL=http://203.0.113.10:3000
FORGE_ALLOWED_ORIGINS=http://203.0.113.10:3000

# --- GitHub: clone from github.com; OAuth app callback must match exactly
FORGE_GIT_BASE_URL=https://github.com
FORGE_GITHUB_CLIENT_ID=<from the OAuth app>
FORGE_GITHUB_CLIENT_SECRET=<from the OAuth app>
FORGE_GITHUB_CALLBACK_URL=http://203.0.113.10:8080/api/v1/github/callback

# --- Email: Mailpit container
FORGE_SMTP_HOST=localhost
FORGE_SMTP_PORT=1025

# --- Optional: demo account, created at startup and offered on the login page.
# Anyone can then sign in and deploy code on this server: use it only while you demo.
FORGE_DEMO_EMAIL=
FORGE_DEMO_PASSWORD=

# --- Optional: LLM agent (rule-based diagnosis works without it)
ANTHROPIC_API_KEY=
