# Copy to .env (git-ignored) and fill in. Generate keys with: openssl rand -base64 32
FORGE_ENCRYPTION_KEY=
FORGE_JWT_SECRET=

# Optional: GitHub OAuth app (Settings → Developer settings → OAuth Apps)
# Callback URL: http://localhost:8080/api/v1/github/callback
FORGE_GITHUB_CLIENT_ID=
FORGE_GITHUB_CLIENT_SECRET=
# Optional: secret configured on the repository webhook (push events → /api/v1/webhooks/github)
FORGE_GITHUB_WEBHOOK_SECRET=

# Optional: enables the LLM-powered Forge agent (rule-based diagnosis is used otherwise)
ANTHROPIC_API_KEY=

# Container engine for user apps: apple (default, Apple container on macOS) or docker
FORGE_ENGINE=apple
# Shared secret Traefik sends when polling /internal/routing (scripts/infra.sh adds one if missing)
FORGE_ROUTING_TOKEN=
# Only for the docker engine: registry images are pushed to, e.g. localhost:5001
FORGE_REGISTRY=

# Integration tests: use a local Postgres instead of Testcontainers
# FORGE_TEST_DB_URL=jdbc:postgresql://localhost:5432/forge_test
