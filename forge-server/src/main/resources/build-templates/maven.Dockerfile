# Generated by Forge for a Maven project (multi-stage: the build tools never reach production).
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
# Keep the build JVM small so builds fit on a laptop next to the platform itself.
ENV MAVEN_OPTS="-Xmx512m -XX:+UseSerialGC -XX:TieredStopAtLevel=1"
COPY . .
RUN if [ -x ./mvnw ]; then ./mvnw -q -B -DskipTests package; else mvn -q -B -DskipTests package; fi \
 && cp "$(ls target/*.jar | grep -v -e '-plain.jar' -e '-sources.jar' -e 'original-' | head -n 1)" /app.jar

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 forge
COPY --from=build /app.jar /app/app.jar
USER forge
ENV PORT={{PORT}} SERVER_PORT={{PORT}} JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75"
EXPOSE {{PORT}}
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
