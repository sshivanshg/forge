# Generated by Forge for a Gradle project (multi-stage: the build tools never reach production).
FROM gradle:8-jdk21 AS build
WORKDIR /src
COPY . .
RUN if [ -x ./gradlew ]; then ./gradlew --no-daemon -q build -x test; else gradle --no-daemon -q build -x test; fi \
 && cp "$(ls build/libs/*.jar | grep -v -e '-plain.jar' -e '-sources.jar' | head -n 1)" /app.jar

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 forge
COPY --from=build /app.jar /app/app.jar
USER forge
ENV PORT={{PORT}} SERVER_PORT={{PORT}} JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75"
EXPOSE {{PORT}}
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
